# InfraWatch environment configuration.
#
# Copy this file to .env and adjust values as needed:
#
#   cp .env.example .env
#
# .env is ignored by Git. Never commit real secrets. Variables are added here
# as each service is implemented; milestone M1 introduces the database,
# object storage, mail and token-signing settings.

# ------------------------------------------------------------------ API
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------ Web
# Host port for the web app; change it if 3000 is already taken.
WEB_PORT=3000

# ------------------------------------------------------------ Database
# These passwords are embedded in connection URLs: use URL-safe characters only.
POSTGRES_PASSWORD=local-dev-superuser
DB_OWNER_PASSWORD=local-dev-owner
DB_APP_PASSWORD=local-dev-app

# --------------------------------------------- Object storage (RustFS, S3 API)
S3_ACCESS_KEY=infrawatch
S3_SECRET_KEY=local-dev-object-store
